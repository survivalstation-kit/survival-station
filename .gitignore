# build logs and progress (written by setup\build-drive.ps1 and the builder window)
logs/
# downloads in progress, if the project folder is ever used as a build target
.download/
*.part
# written by the start files each time the kit starts (this computer's network addresses)
portal/kit-address.json
# personal documents, if the project folder is ever used as a kit (PRIVATE-DOCS.bat)
private/
# local editor and tool settings
.claude/
__pycache__/
*.pyc
# the user's own data, if the project folder is ever used as a kit: lists, supplies, map pins, encrypted favorites
my-data/
favorites.vault
# downloaded by the builder onto every kit (official guides)
portal/guides/
